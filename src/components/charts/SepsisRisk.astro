---
import { scaleLinear } from 'd3-scale';
import { line } from 'd3-shape';
import data from '../../data/sepsis-patient.json';
import { SIZES } from '../../lib/chart';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const pts = data.points;
const hours = pts.map((p) => p.hour);
const xMin = Math.min(...hours);
const xMax = Math.max(...hours);
const onset = data.onsetHour;
const alertHour = data.firstAlertHour;
const alertRisk = pts.find((p) => p.hour === alertHour)!.risk;
const lead = onset - alertHour;
const thr = data.threshold;

const charts = SIZES.map((s) => {
  const m = { t: 30, r: 14, b: 34, l: 34 };
  const x = scaleLinear().domain([xMin, xMax]).range([m.l, s.w - m.r]);
  const y = scaleLinear().domain([0, 0.8]).range([s.h - m.b, m.t]);
  const path = line<{ hour: number; risk: number }>().x((d) => x(d.hour)).y((d) => y(d.risk))(pts) ?? '';
  const xTicks = [10, 20, 30, 40, 50, 60, 70].filter((t) => t >= xMin && t <= xMax);
  return { s, m, x, y, path, xTicks, yTicks: [0, 0.2, 0.4, 0.6, 0.8] };
});
const label = `Line chart of hourly sepsis risk for held-out patient ${data.patient}. Risk stays below the ${thr} alert threshold for most of the stay, crosses it at hour ${alertHour}, and clinical onset follows at hour ${onset}, ${lead} hours later.`;
---
<figure class="chart">
  <figcaption class="title">One patient, replayed hour by hour</figcaption>
  {!compact && <p class="sub">The model crossed its alert threshold at hour {alertHour}. Clinical onset came at hour {onset}. Shaded: the window the official metric rewards, 12 hours before onset to 3 hours after.</p>}
  {charts.map(({ s, m, x, y, path, xTicks, yTicks }) => (
    <svg class={s.key} viewBox={`0 0 ${s.w} ${s.h}`} role="img" aria-label={label} font-size={s.font}>
      <rect class="band" x={x(onset - 12)} y={m.t} width={x(xMax) - x(onset - 12)} height={s.h - m.b - m.t} />
      <g class="grid">
        {yTicks.map((t) => <line x1={m.l} x2={s.w - m.r} y1={y(t)} y2={y(t)} />)}
      </g>
      {yTicks.map((t) => <text x={m.l - 6} y={y(t) + 4} text-anchor="end">{t === 0 ? '0' : t.toFixed(1)}</text>)}
      <text x={m.l - 6} y={m.t - 14} text-anchor="end">risk</text>
      <line class="baseline" x1={m.l} x2={s.w - m.r} y1={s.h - m.b} y2={s.h - m.b} />
      {xTicks.map((t) => <text x={x(t)} y={s.h - m.b + 16} text-anchor="middle">{t}</text>)}
      <text x={s.w - m.r} y={s.h - 2} text-anchor="end">hours in ICU</text>

      <line class="thresh" x1={m.l} x2={s.w - m.r} y1={y(thr)} y2={y(thr)} />
      <text x={m.l + 6} y={y(thr) - 6} class="t-strong">alert threshold {thr}</text>

      <line class="marker" x1={x(onset)} x2={x(onset)} y1={m.t - 6} y2={s.h - m.b} />
      <text x={x(onset) - 5} y={m.t - 10} text-anchor="end" class="t-strong">onset, hour {onset}</text>
      {s.key === 'lg' && <text x={x(onset - 12) + 6} y={m.t + 14} class="t-accent">useful window</text>}

      <path class="series" d={path} />
      <circle class="dot" cx={x(alertHour)} cy={y(alertRisk)} r="5" />
      <text x={x(alertHour) - 10} y={y(alertRisk) - 10} text-anchor="end" class="t-accent">first alert, {lead} h early</text>
    </svg>
  ))}
  <p class="source">Source: PhysioNet 2019 Challenge, held-out patient {data.patient}. Scores precomputed by the committed model for the project's live demo.</p>
</figure>
