---
// The resume as HTML. Same structure as the PDF, but project numbers follow the
// current READMEs (see the Corrections boxes on the Sepsis and Shrinkflation stories).
import { SITE } from '../config';

const skills = [
  { group: 'Languages & Frameworks', items: 'Python, TypeScript, JavaScript, SQL, C++, Java, C#, HTML/CSS, React, Next.js, Svelte, Astro, Node.js, FastAPI, Flask, D3.js' },
  { group: 'AI / ML', items: 'Google Cloud ADK, Gemini, Claude API, Elasticsearch, Neo4j, LangChain, vector embeddings, scikit-learn, pandas, NumPy' },
  { group: 'Cloud & Tools', items: 'GCP, Firebase, Supabase, AWS, PostgreSQL, MongoDB, Git, GitHub Actions, Docker, Vercel, Power BI, Azure ML, Power Automate, Oracle, Coupa, ServiceNow, Excel' },
];

const experience = [
  {
    org: 'Kroger Finance', role: 'Contracting Efficiencies & Enablement Intern', when: 'May 2026 to Aug 2026',
    bullets: [
      'Led two technology RFPs, including a $48M+ AI sourcing initiative for ML-based produce-freshness solutions, driving technical evaluation of competing ML offerings, sourcing, and cross-functional communication end to end.',
      "Built a pipeline to categorize and align ~20% of the team's tech spend, surfacing vendor consolidation opportunities and informing sourcing decisions.",
    ],
  },
  {
    org: 'Kroger Technology & Digital', role: 'Portfolio Analyst Intern', when: 'Jan 2025 to Aug 2025',
    bullets: [
      'Built Power BI dashboards adopted by 50+ IT staff, improving outage detection analysis by 25% and giving visibility into Time to Detect, Time to Resolve and root-cause trends.',
      'Designed and optimized Coupa and Oracle reporting spaces covering $80M+ in vendor spend, improving efficiency for 30+ finance managers.',
      'Evaluated Power Automate to streamline the Coupa to Power BI data flow, and built documentation frameworks for multi-year SOW cost tracking.',
      'Managed offshore desktop inventory reporting with 10 global vendors, consolidating 150+ monthly line items into pivot summaries for leadership.',
    ],
  },
  {
    org: 'Owens Corning', role: 'Data Analyst Intern', when: 'May 2024 to Aug 2024',
    bullets: [
      'Built 98%-accurate anomaly detection thresholds from 6 months of plant history for the Toronto and Waxahachie plants; detected a 15% glass-heat anomaly that triggered a multi-system reorganization.',
      'Helped automate real-time anomaly detection graphs (Power BI, Seeq, TwinThread, Python, Excel) at a 99.3% success rate; cloud analysis for the Memphis and Medina plants improved operational efficiency by 10%.',
    ],
  },
  {
    org: 'RentRadar', role: 'Founder', when: 'May 2025 to present',
    bullets: [
      'Founded and shipped rentradar.org (React, Flask, LangChain, PostgreSQL) to crowdsource rent fairness and landlord data, leading product, growth and monetization to 60 active users and 30 reviews in the first cycle; live with 50+ active users. 2nd place overall, CEAS Summer Innovation Challenge; $5K in funding.',
    ],
  },
];

const projects = [
  {
    name: 'Aero', stack: 'Electron, JavaScript, Claude Haiku, Cartesia', when: 'Nov 2026',
    text: "First place, Digital Health Hackathon 2026 (Cincinnati Children's, with Cintrifuse); team of three. Talking-crane assistant for the SMART@Home clinician view: Claude Haiku calls lookup tools so answers come from patient data, and Cartesia speaks them. Built the model loop, voice and widget canvas.",
  },
  {
    name: 'Jeremy.ai', stack: 'Unity, Meta Quest 3, FastAPI, Claude, Convex', when: 'Oct 2026',
    text: 'CalHacks 13 team of four. AR laparoscopic surgery trainer where deterministic code scores each attempt and Claude only explains it. Built the voice coach, session report, mistake-cost model, Apify price Actor and instructor dashboard. 523 backend tests; 9 of 9 surveyed medical and bio respondents said yes.',
  },
  {
    name: 'Sepsis Early-Warning System', stack: 'Python, scikit-learn, FastAPI, Docker', when: 'Jul 2026',
    text: 'Hourly ICU sepsis model on PhysioNet 2019 Challenge data with causal, leakage-tested features and patient-level splits. On 4,441 held-out patients: 0.424 official utility, AUROC 0.817, and 93% of septic patients flagged a median 12 hours before onset, with the 59% false-alarm rate reported alongside.',
  },
  {
    name: 'Floodplain Creep', stack: 'Python, FastAPI, PostgreSQL, React, MapLibre, Gemini', when: 'Nov 2026',
    text: 'Solo hackathon build. Maps new buildings in modeled flood zones in Dhaka by neighborhood. Hides counts under 20, checks every number in Gemini-written briefs against computed data, and reports its own measured accuracy.',
  },
  {
    name: 'claude-coding-hub', stack: 'TypeScript, MCP, SQLite', when: 'Oct 2026',
    text: 'MCP server that lets Claude Code delegate to Codex, Gemini CLI, Grok and OpenCode in isolated git worktrees. Each risky action needs a human decision on the exact request, and the lead model has no approve tool. 65 tests; Codex and OpenCode workers verified against the real CLIs.',
  },
  {
    name: 'AFib ECG Classifier', stack: 'Python, SciPy, scikit-learn, React', when: 'Oct 2026',
    text: 'Classifies single-lead ECGs as Normal, AFib, Other or Noisy from beat detection and 34 features with gradient boosting. Held-out mean F1 of 0.780 against 0.667 for a logistic regression baseline; test set never used for tuning.',
  },
  {
    name: 'Shrinkflation Sleuth', stack: 'Python, Google ADK, Gemini, Elasticsearch, MCP', when: 'Jun 2026',
    text: 'Single Google ADK agent with six playbooks that answers shrinkflation questions through five read-only Elastic MCP tools and ES|QL, leading every answer with the effective price-per-unit increase. Built in three days for the Google Cloud Rapid Agent Hackathon (Elastic track).',
  },
];
---
<div class="resume-doc">
  <div class="print-only">
    <p class="resume-print-name">{SITE.name}</p>
    <p class="resume-contact">Cincinnati, OH (open to relocation) · {SITE.email} · linkedin.com/in/shawn-lasrado · github.com/ShawnJoshua03 · shawnjoshua03.github.io</p>
  </div>

  <h3 id="education">Education</h3>
  <div class="entry">
    <div class="entry-head"><b>{SITE.school}</b><span>{SITE.grad}</span></div>
    <div>B.S. Computer Science, Information Technology minor</div>
    <div>Coursework: AI, Machine Learning, Algorithms, Database Design, Data Visualization, Operating Systems, Networking</div>
  </div>

  <h3>Skills</h3>
  {skills.map((s) => <div class="entry" style="margin-bottom:0.3rem"><b>{s.group}:</b> {s.items}</div>)}

  <h3>Experience</h3>
  {experience.map((e) => (
    <div class="entry">
      <div class="entry-head"><b>{e.org} · {e.role}</b><span>{e.when}</span></div>
      <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
    </div>
  ))}

  <h3>Projects</h3>
  {projects.map((p) => (
    <div class="entry">
      <div class="entry-head"><b>{p.name} · <span style="font-family:var(--font-mono);font-size:0.78rem;font-weight:400">{p.stack}</span></b><span>{p.when}</span></div>
      <div>{p.text}</div>
    </div>
  ))}

  <h3>Activities</h3>
  <div class="entry">
    <div class="entry-head"><b>SASE · South Central Regional Coordinator (prev. Co-President)</b><span>Jun 2026 to present</span></div>
    <ul><li>Work with representatives from 25+ SASE chapters to organize national and regional conferences that promote networking between students and company representatives.</li></ul>
  </div>
  <div class="entry">
    <div class="entry-head"><b>TEDxGnms · Speaker</b><span>Oct 2020</span></div>
    <ul><li>Delivered an 8-minute talk on perseverance to 200+ people.</li></ul>
  </div>

</div>
