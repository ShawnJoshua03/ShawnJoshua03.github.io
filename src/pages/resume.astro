---
import Base from '../layouts/Base.astro';
import Resume from '../components/Resume.astro';
import { SITE } from '../config';
---
<Base title={`Resume · ${SITE.name}`} description={`Resume of ${SITE.name}: ${SITE.degree}, ${SITE.school}, ${SITE.grad}.`}>
  <section class="resume wrap" aria-labelledby="resume-h">
    <div class="resume-head no-print">
      <div>
        <p class="eyebrow">Resume</p>
        <h1 id="resume-h">{SITE.name}</h1>
      </div>
      <div class="btn-row">
        <a class="btn primary" href={SITE.resumePdf} download>Download PDF</a>
        <button class="btn print-btn" type="button" hidden>Print</button>
      </div>
    </div>
    <Resume />
  </section>
</Base>

<script>
  const b = document.querySelector<HTMLButtonElement>('.print-btn');
  if (b) { b.hidden = false; b.addEventListener('click', () => window.print()); }
</script>

<style is:global>
  .resume { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: 4rem; }
  .resume-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 3px double var(--rule-strong); }
  .resume-head h1 { font-size: clamp(2.6rem, 7vw, 5rem); font-weight: 800; font-variation-settings: 'opsz' 144; letter-spacing: -0.04em; line-height: 0.95; }
  .resume-doc { margin-top: 1.5rem; max-width: 52rem; font-size: 1rem; line-height: 1.45; }
  .resume-doc h3 { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; border-bottom: 1px solid var(--rule-strong); padding-bottom: 0.25rem; margin: 1.5rem 0 0.6rem; }
  .resume-doc .entry { margin-bottom: 0.9rem; break-inside: avoid; }
  .resume-doc .entry-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 1rem; }
  .resume-doc .entry-head b { font-family: var(--font-head); font-size: 1.08rem; }
  .resume-doc .entry-head span { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-2); }
  .resume-doc ul { margin: 0.3rem 0 0; padding-left: 1.1em; }
  .resume-doc li { margin-bottom: 0.2rem; }
  .resume-doc .contact { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-2); }
  .print-only { display: none; }

  @media print {
    @page { margin: 0.35in 0.45in; }
    :root, :root[data-theme='dark'] {
      --paper: #fff; --paper-2: #fff; --ink: #000; --ink-2: #222; --ink-3: #444; --rule: #999; --rule-strong: #000; --accent: #000;
    }
    body { background: #fff; color: #000; }
    .site-header, .contact, .skip, .no-print { display: none !important; }
    .print-only { display: block; }
    .wrap { max-width: none; padding: 0; }
    a { text-decoration: none; color: inherit; }
    .resume { padding: 0; }
    .resume-doc { max-width: none; margin: 0; font-size: 8.4pt; line-height: 1.18; }
    .resume-doc h3 { margin: 0.45rem 0 0.2rem; font-size: 7.8pt; padding-bottom: 0.1rem; }
    .resume-doc .entry { margin-bottom: 0.28rem; }
    .resume-doc ul { margin-top: 0.1rem; }
    .resume-doc li { margin-bottom: 0.05rem; }
    .resume-doc .entry-head b { font-size: 9.2pt; }
    .resume-doc .entry-head span, .resume-doc .contact { font-size: 7.6pt; }
    .resume-print-name { font-family: var(--font-head); font-size: 18pt; font-weight: 750; margin: 0; }
    .todo { display: none; }
  }
</style>
